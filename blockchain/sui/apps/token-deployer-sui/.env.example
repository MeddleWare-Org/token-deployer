# Copy to .env (or set in the Cloudflare Pages dashboard) before deploying.
# All are optional; sensible public defaults are used when unset.

# Operator fee (MIST) split from the user's gas coin into your treasury.
# Default 1 SUI (1000000000 MIST) — trivial, ~7.5x under competitor pricing.
VITE_FEE_MIST=1000000000

# Operator treasury addresses per network (REQUIRED for the fee to be collected).
# The committed operator defaults live in `.env.production` (auto-loaded by
# `vite build`). A production build FAILS if a selectable network's treasury is
# still the zero address, so revenue can never silently burn — set both below or
# in `.env.production`. Set VITE_ALLOW_UNSET_TREASURY=1 to bypass (dev/e2e only).
VITE_FEE_TREASURY_TESTNET=0xe6b2810abfc5a6f37a375f73e3ba76cfc37584196e453255ad3c9ca2f0ede0ed
VITE_FEE_TREASURY_MAINNET=0xe6b2810abfc5a6f37a375f73e3ba76cfc37584196e453255ad3c9ca2f0ede0ed

# Optional RPC overrides. Set a paid/private endpoint for production to avoid public
# rate limits. NOTE: the official testnet fullnode (fullnode.testnet.sui.io) is gRPC-only
# and 404s for JSON-RPC — use a JSON-RPC-capable endpoint for testnet (the app defaults to
# https://sui-testnet-rpc.publicnode.com). The same VITE_RPC_TESTNET is what the real-chain
# e2e (npm run e2e:testnet) builds against; point E2E_RPC at the same endpoint.
# VITE_RPC_TESTNET=https://sui-testnet-rpc.publicnode.com
# VITE_RPC_MAINNET=https://fullnode.mainnet.sui.io:443

# Optional publish gas budget (MIST).
# VITE_PUBLISH_GAS_BUDGET=500000000

# --- Walrus icon upload -----------------------------------------------------
# Operator's own upload relay per network. Set these to a relay YOU run (the
# stock mysten/walrus-upload-relay container) to collect the native per-upload
# tip as revenue. Unset → the public Mysten relay is used (uploads still work
# but tip Mysten, not you). See the relay runbook in README.md / CLAUDE.md.
# VITE_WALRUS_RELAY_TESTNET=https://walrus-relay-testnet.meddleware.co.uk
# VITE_WALRUS_RELAY_MAINNET=https://walrus-relay.meddleware.co.uk

# Client-side max relay tip (MIST). COUPLING: the Walrus SDK hard-fails an upload
# if your relay's tip exceeds this, so keep it comfortably ABOVE the relay tip.
# Default 0.05 SUI. Raising the relay tip past this needs a frontend redeploy.
# VITE_WALRUS_MAX_TIP_MIST=50000000

# Icon constraints (UX/cost guard only — the authoritative cap is the edge body
# limit in front of the relay). Default 100 KiB; PNG/JPEG/WebP/SVG.
# VITE_ICON_MAX_BYTES=102400
# VITE_ICON_ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/svg+xml

# Public site origin for canonical/OpenGraph/JSON-LD URLs (index.html). Committed
# defaults live in .env.production / .env.development; a staging deploy should set
# this so it never claims the production URL.
# VITE_PUBLIC_URL=https://tokens.meddleware.co.uk
